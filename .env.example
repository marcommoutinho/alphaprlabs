# Copy to .env.local and fill in. Names only — never commit real values.
# Local Supabase values come from `npm run db:status`.

# Host routing (src/proxy.ts). Leave APP_HOST empty to serve everything on
# one host with no redirects. Locally: APP_HOST=app.localhost:3000 and
# PUBLIC_HOST=www.localhost:3000 (not localhost:3000; see src/lib/host-routing.ts).
# Production: app.alphaprlabs.com and the public domain.
APP_HOST=
PUBLIC_HOST=

# Supabase: project URL and publishable key (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key: server-only, never exposed to the browser.
SUPABASE_SECRET_KEY=
