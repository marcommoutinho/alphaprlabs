# Copy to .env.local and fill in. Names only — never commit real values.
# Local Supabase values come from `npm run db:status`.

# Host routing (src/proxy.ts). Leave APP_HOST empty to serve everything on
# one host with no redirects. Locally: APP_HOST=app.localhost:3000 and
# PUBLIC_HOST=www.localhost:3000 (not localhost:3000; see src/lib/host-routing.ts).
# Production: app.alphaprlabs.com and the public domain.
APP_HOST=
PUBLIC_HOST=

# Supabase: project URL and publishable key (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key: server-only, never exposed to the browser.
SUPABASE_SECRET_KEY=

# SMTP for the app's own invitation emails (src/lib/invitations/email.ts).
# Locally: Supabase's captured inbox, SMTP_HOST=127.0.0.1 SMTP_PORT=54425 (no
# user/pass), e.g. SMTP_FROM="Alpha PR Labs <research@alphaprlabs.local>".
# Production: Postmark SMTP (smtp.postmarkapp.com, port 587, server API token
# as both user and password), with TLS required automatically.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web Push (reminders). Generate a key pair once per environment with
# `npm run push:keys` and never commit it. The public key is browser-safe;
# the private key is server-only. VAPID_SUBJECT is a contact the push services
# can reach, e.g. mailto:research@alphaprlabs.com.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Shows "Send test notification" on Reminders settings (sends to the signed-in
# researcher's own devices). Off unless exactly "true"; on only for gate G1.
PUSH_TEST_ENABLED=

# Daily Bank of Canada USD→CAD rate sync (src/app/api/cron/fx-rates/route.ts,
# scheduled in vercel.json). Vercel Cron sends `Authorization: Bearer
# $CRON_SECRET`; without it set, the route refuses every call. Production only:
# a random string of at least 16 characters, e.g. `openssl rand -hex 32`.
# Backfill from a terminal instead: `npm run fx:backfill -- --from 2025-01-01`.
CRON_SECRET=

# Dose and supplement reminders (S13): the dispatcher at /api/cron/reminders,
# called every minute by Vercel Cron (vercel.json; needs the Pro plan) with the
# same CRON_SECRET, and locally by `npm run reminders:tick`. The send on/off
# control: nothing is planned or sent unless this is exactly "true" (unset =
# off). It also needs the VAPID keys above. Turning it off stops sends at the
# next call; queued reminders past their time are then skipped, never sent late.
REMINDERS_ENABLED=

# Tests only: serves stubbed Bank of Canada rates (src/lib/inventory/fx.ts),
# honoured only against the local Supabase stack. Never set it elsewhere.
# BOC_FX_TEST_RATES=
